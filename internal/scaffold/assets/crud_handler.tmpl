// scan{{$.EntityName}} reads a single row into a *pb.{{$.EntityName}}.
// Shared by Create/Update inline-select and the List handler.
func scan{{$.EntityName}}(scanner interface{ Scan(...interface{}) error }) (*pb.{{$.EntityName}}, error) {
	var entity pb.{{$.EntityName}}
	var createdAt, updatedAt sql.NullTime
	var createdBy, updatedBy sql.NullString
	{{range $.EnumFields}}var {{.GoName}}Str string
	{{end}}{{range $.TimestampFields}}var {{.GoName}}Time sql.NullTime
	{{end}}{{range $.OptionalEntityFieldsData}}{{if eq .Type "string"}}var {{.GoName}}Null sql.NullString
	{{else if eq .Type "int32"}}var {{.GoName}}Null sql.NullInt32
	{{else if eq .Type "int64"}}var {{.GoName}}Null sql.NullInt64
	{{else if eq .Type "uint32"}}var {{.GoName}}Null sql.NullInt64
	{{else if eq .Type "uint64"}}var {{.GoName}}Null sql.NullInt64
	{{else if eq .Type "float32"}}var {{.GoName}}Null sql.NullFloat64
	{{else if eq .Type "float64"}}var {{.GoName}}Null sql.NullFloat64
	{{else if eq .Type "bool"}}var {{.GoName}}Null sql.NullBool
	{{end}}{{end}}
	err := scanner.Scan(
		{{range $.ScanFields}}&{{.}},
		{{end}}&createdAt,
		&updatedAt,
		&createdBy,
		&updatedBy,
	)
	if err != nil {
		return nil, err
	}

	{{range $.EnumFields}}{{$field := .}}switch {{.GoName}}Str {
	{{range .EnumValues}}case "{{. | lower}}":
		entity.{{$field.GoName}} = pb.{{$field.EnumType}}_{{.}}
	{{end}}default:
		entity.{{$field.GoName}} = pb.{{$field.EnumType}}_{{$field.DefaultValue}}
	}
	{{end}}
	if createdAt.Valid {
		entity.CreatedAt = timestamppb.New(createdAt.Time)
	}
	if updatedAt.Valid {
		entity.UpdatedAt = timestamppb.New(updatedAt.Time)
	}
	{{if isOptionalEntity "created_by" $.OptionalEntityFields}}if createdBy.Valid {
		entity.CreatedBy = &createdBy.String
	}{{else}}if createdBy.Valid {
		entity.CreatedBy = createdBy.String
	}{{end}}
	{{if isOptionalEntity "updated_by" $.OptionalEntityFields}}if updatedBy.Valid {
		entity.UpdatedBy = &updatedBy.String
	}{{else}}if updatedBy.Valid {
		entity.UpdatedBy = updatedBy.String
	}{{end}}
	{{range $.TimestampFields}}if {{.GoName}}Time.Valid {
		entity.{{.GoName}} = timestamppb.New({{.GoName}}Time.Time)
	}
	{{end}}{{range $.OptionalEntityFieldsData}}{{if eq .Type "string"}}if {{.GoName}}Null.Valid {
		val := {{.GoName}}Null.String
		entity.{{.GoName}} = &val
	}
	{{else if eq .Type "int32"}}if {{.GoName}}Null.Valid {
		val := {{.GoName}}Null.Int32
		entity.{{.GoName}} = &val
	}
	{{else if eq .Type "int64"}}if {{.GoName}}Null.Valid {
		val := {{.GoName}}Null.Int64
		entity.{{.GoName}} = &val
	}
	{{else if eq .Type "uint32"}}if {{.GoName}}Null.Valid {
		val := uint32({{.GoName}}Null.Int64)
		entity.{{.GoName}} = &val
	}
	{{else if eq .Type "uint64"}}if {{.GoName}}Null.Valid {
		val := uint64({{.GoName}}Null.Int64)
		entity.{{.GoName}} = &val
	}
	{{else if eq .Type "float32"}}if {{.GoName}}Null.Valid {
		val := float32({{.GoName}}Null.Float64)
		entity.{{.GoName}} = &val
	}
	{{else if eq .Type "float64"}}if {{.GoName}}Null.Valid {
		val := {{.GoName}}Null.Float64
		entity.{{.GoName}} = &val
	}
	{{else if eq .Type "bool"}}if {{.GoName}}Null.Valid {
		val := {{.GoName}}Null.Bool
		entity.{{.GoName}} = &val
	}
	{{end}}{{end}}
	return &entity, nil
}

// build{{$.EntityName}}Where assembles a WHERE clause from FilterCriteria. Delegates
// to helper.BuildWhereClause which supports both single conditions and nested
// FilterGroup (AND/OR) — including recursion — and applies the whitelist.
func build{{$.EntityName}}Where(filters []*commonpb.FilterCriteria) (string, []interface{}) {
	whiteMap := map[string]bool{
		{{range $.FilterableFields}}"{{.}}": true,
		{{end}}
	}
	args := []interface{}{}
	whereClause := helper.BuildWhereClause(filters, &args, whiteMap)
	return whereClause, args
}

