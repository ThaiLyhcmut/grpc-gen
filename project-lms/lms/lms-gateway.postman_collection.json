              "mode": "graphql",
              "graphql": {
                "query": "{ listUser { items { id email password_hash } } }",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Không token. KỲ VỌNG: email + password_hash đều null (forbidden / unauthenticated)."
          }
        },
        {
          "name": "listUser email+hash — STUDENT (sub=3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
