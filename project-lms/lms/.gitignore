.DS_Store
Thumbs.db

# TLS keys/certs (per-service generated, never commit)
**/certs/*.key
**/certs/*.crt
**/certs/*.pem
**/certs/*.csr
**/certs/*.srl

# Generated proto Go files (regen with `make proto-*`)
proto/*/*.pb.go

# Stray compiled service binaries (just service name, no extension)
/user
/class
/lesson
/material
/exam
/submission
/notification
/audit
